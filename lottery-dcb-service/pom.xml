<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.lotterydcb</groupId>
        <artifactId>lottery-dcb</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lottery-dcb-service</artifactId>
    <name>lottery-dcb-service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>lottery-dcb</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>static/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${project.basedir}/../lottery-dcb-web/dist</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>../lottery-dcb-web</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                    <skip>${skip.frontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.lotterydcb.LotteryDcbApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>replace-and-verify-frontend</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="前端未编译：缺少 lottery-dcb-web/dist/index.html，请勿跳过前端构建">
                                    <condition>
                                        <not>
                                            <available file="${project.basedir}/../lottery-dcb-web/dist/index.html"/>
                                        </not>
                                    </condition>
                                </fail>
                                <delete dir="${project.build.outputDirectory}/static" quiet="true"/>
                                <mkdir dir="${project.build.outputDirectory}/static"/>
                                <copy todir="${project.build.outputDirectory}/static" overwrite="true" failonerror="true">
                                    <fileset dir="${project.basedir}/../lottery-dcb-web/dist"/>
                                </copy>
                                <fail message="前端资源复制失败：JAR 暂存目录中缺少 index.html">
                                    <condition>
                                        <not>
                                            <available file="${project.build.outputDirectory}/static/index.html"/>
                                        </not>
                                    </condition>
                                </fail>
                                <loadfile property="packaged.frontend.index" srcFile="${project.build.outputDirectory}/static/index.html"/>
                                <fail message="前端资源仍为占位页，已终止 JAR 打包">
                                    <condition>
                                        <contains string="${packaged.frontend.index}" substring="前端尚未编译"/>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-executable-jar-to-project-root</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="Spring Boot 可执行 JAR 尚未生成，无法同步到项目根目录">
                                    <condition>
                                        <not>
                                            <available file="${project.build.directory}/${project.build.finalName}.jar"/>
                                        </not>
                                    </condition>
                                </fail>
                                <delete dir="${project.build.directory}/jar-verification" quiet="true"/>
                                <unzip src="${project.build.directory}/${project.build.finalName}.jar"
                                       dest="${project.build.directory}/jar-verification"/>
                                <fail message="JAR 中缺少最新前端首页，已停止复制根目录 JAR">
                                    <condition>
                                        <not>
                                            <available file="${project.build.directory}/jar-verification/BOOT-INF/classes/static/index.html"/>
                                        </not>
                                    </condition>
                                </fail>
                                <fail message="当前产物不是 Spring Boot 可执行 JAR，已停止复制">
                                    <condition>
                                        <not>
                                            <available file="${project.build.directory}/jar-verification/BOOT-INF/lib" type="dir"/>
                                        </not>
                                    </condition>
                                </fail>
                                <loadfile property="jar.frontend.index"
                                          srcFile="${project.build.directory}/jar-verification/BOOT-INF/classes/static/index.html"/>
                                <fail message="JAR 中仍包含前端占位页，已停止复制">
                                    <condition>
                                        <contains string="${jar.frontend.index}" substring="前端尚未编译"/>
                                    </condition>
                                </fail>
                                <delete file="${project.basedir}/../lottery-dcb.jar" quiet="true"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${project.basedir}/../lottery-dcb.jar"
                                      overwrite="true"
                                      preservelastmodified="false"
                                      failonerror="true"/>
                                <checksum file="${project.basedir}/../lottery-dcb.jar"
                                          algorithm="SHA-256"
                                          property="packaged.jar.sha256"/>
                                <echo message="已更新项目根目录 lottery-dcb.jar，SHA-256=${packaged.jar.sha256}"/>
                                <delete dir="${project.build.directory}/jar-verification" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/..</directory>
                            <includes>
                                <include>lottery-dcb.jar</include>
                            </includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/../lottery-dcb-web/dist</directory>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
